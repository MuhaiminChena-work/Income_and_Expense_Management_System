rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
        data.email is string && data.email.size() <= 256;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
        (data.type == 'income' || data.type == 'expense') &&
        data.amount is number &&
        data.category is string && data.category.size() <= 100 &&
        data.date is string && data.date.size() <= 20;
    }

    function isValidCategory(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() <= 100 &&
        (data.type == 'income' || data.type == 'expense');
    }

    // Connection testing endpoint
    match /test/{testId} {
      allow read: if isSignedIn();
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId);

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // User custom categories subcollection
      match /categories/{categoryId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(categoryId);
        allow create: if isOwner(userId) && isValidId(categoryId) && isValidCategory(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(categoryId) && isValidCategory(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(categoryId);
      }
    }
  }
}
